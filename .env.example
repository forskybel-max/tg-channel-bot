# 1. Токен вашего нового бота от @BotFather
BOT_TOKEN=your_bot_token_here

# 2. Ваш числовой Telegram ID (можно несколько через запятую, узнать у @userinfobot)
ADMIN_IDS=123456789

# 3. Строка подключения PostgreSQL из Supabase:
# В Supabase откройте проект -> кнопка "Connect" сверху -> вкладка "ORMs / URI" ->
# выберите "Transaction pooler" (порт 6543) или "Session pooler" (порт 5432) для поддержки IPv4!
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 4. Опционально: ваш канал для проверки подписки (также можно менять прямо в админке бота!)
# Не забудьте добавить бота в администраторы канала, чтобы он видел подписчиков.
CHANNEL_ID=
CHANNEL_URL=
